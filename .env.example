# PAI-IR Environment Variables Template

# System Setup
SYSTEM_MODE=SIMULATION
DEBUG=true
PORT=8000

# Database Connection
DATABASE_URL=sqlite:///./database/pai_ir.db

# AI & VLM API Credentials
AI_API_KEY=your_ai_api_key_here
VLM_API_KEY=your_vlm_api_key_here
STT_API_KEY=your_stt_api_key_here
TTS_API_KEY=your_tts_api_key_here

# ROS 2 Configuration
ROS_DOMAIN_ID=42
ROS_DISTRO=humble

# Hardware Devices
CAMERA_DEVICE=/dev/video0
LIDAR_PORT=/dev/ttyUSB0
